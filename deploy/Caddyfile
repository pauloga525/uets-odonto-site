# HTTPS automático para el dominio definido en APP_DOMAIN (.env).
# Caddy obtiene el certificado de Let's Encrypt la primera vez y lo renueva solo.
# Requisito: los puertos 80 y 443 del servidor deben ser accesibles desde internet.
# Con APP_DOMAIN=localhost usa un certificado local (útil para probar la pila completa).

{$APP_DOMAIN} {
	encode zstd gzip

	# El Nginx interno sirve la app y reenvía /api (REST + WebSocket) a la API
	reverse_proxy web:80

	log {
		output stdout
		format console
	}
}
