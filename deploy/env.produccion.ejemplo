# ===================== Configuración de PRODUCCIÓN =====================
# deploy/instalar-ubuntu.sh copia este archivo a .env y completa los secretos.

NODE_ENV=production
PORT=3000
APP_TIMEZONE=America/Guayaquil
COOKIE_SECURE=true
AUTH_DEV_LOGIN=false

# Servicios a levantar (lo completa el instalador):
#   prod,tunnel  Cloudflare Tunnel rápido (*.trycloudflare.com), sin abrir puertos
#   prod,caddy   Caddy + sslip.io (requiere puertos 80/443)
COMPOSE_PROFILES=prod,tunnel

# Dirección pública. En modo túnel se dejan VACÍAS: la app la deduce de cada petición.
APP_DOMAIN=
WEB_URL=
GOOGLE_REDIRECT_URI=

# Base de datos (contraseña generada por el instalador)
POSTGRES_PASSWORD=

# Google OAuth (Google Cloud → Credenciales → ID de cliente OAuth, tipo "Aplicación web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secretos (generados por el instalador; NO cambiarlos después: invalidan sesiones y
# DATA_ENCRYPTION_KEY es necesaria para leer las observaciones clínicas ya guardadas)
JWT_ACCESS_SECRET=
DATA_ENCRYPTION_KEY=

# Reglas de acceso
ALLOWED_DOMAINS=uets.edu.ec
BLOCKED_EMAIL_PATTERNS=*.est@uets.edu.ec
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_DOCTOR_EMAIL=
